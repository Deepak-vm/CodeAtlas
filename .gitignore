# Python
__pycache__/
*.pyc
*.pyo
.mypy_cache/
.pytest_cache/
*.egg-info/
dist/
build/

# Virtual environments
venv/
.venv/
env/

# Data (generated — persisted on Render disk, not in git)
data/chunks/
data/indexes/
data/repos/

# Environment & Config (secrets must never be committed)
.env

# Allow deploy env files (no secrets inside, just URLs)
!.env.production
!.env.development

# Repos config (managed via Supabase in prod, local override only)
repos.json

# Scratch & one-off scripts
rewrite_*.py
fix_git_history.py
feedback.jsonl

# Node / frontend
frontend/node_modules/
frontend/dist/

# IDE
.vscode/
.idea/
*.DS_Store

# Logs
*.log
*.json.bak

# Keep data directory structure (empty sentinel files)
!data/chunks/.gitkeep
!data/indexes/.gitkeep

