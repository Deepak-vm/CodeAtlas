# ── Jina Embeddings API ──────────────────────────────────────────────────────
JINA_API_KEY=your_jina_api_key_here

# Set to "true" to use the Jina REST API instead of local sentence-transformers
# Recommended for production (Render) — no torch/CUDA needed
USE_JINA_API=true

# ── Groq LLM API ─────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Supabase (PostgreSQL via HTTPS REST API) ──────────────────────────────────

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ── LangSmith ────────────────────────
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=Knowledge-Base-Agent
# Set LANGCHAIN_TRACING_V2=true to enable LangSmith tracing
LANGCHAIN_TRACING_V2=false

# ── Frontend URL
FRONTEND_URL=https://your-app.vercel.app
